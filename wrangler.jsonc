{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "value-crm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-18",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
